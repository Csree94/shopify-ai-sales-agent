# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).
# Placeholders only — this file contains no secrets.

# --- LLM (Phase 8) ---
# Primary provider:
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-3.6-flash (Stable; short-term availability per
# Google's lifecycle page — announced retirement window 2026-11-19,
# successor gemini-3.8-flash). Set GEMINI_MODEL to override.
GEMINI_MODEL=gemini-3.6-flash
# Generation-only fallback provider (OpenAI-compatible NVIDIA API):
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# 1/true/yes/on (default) or 0/false/no/off — disables the fallback entirely.
LLM_FALLBACK_ENABLED=true

# --- Shopify ---
# See backend/docs/shopify-setup.md for app setup, auth modes, and required scopes.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Client-credentials grant (preferred auth mode):
SHOPIFY_CLIENT_ID=placeholder_get_from_dev_dashboard
SHOPIFY_CLIENT_SECRET=placeholder_get_from_dev_dashboard
# Static custom-app Admin API token (fallback when client credentials are absent):
SHOPIFY_STOREFRONT_ACCESS_TOKEN=placeholder_get_from_dev_dashboard
SHOPIFY_ADMIN_ACCESS_TOKEN=placeholder_get_from_dev_dashboard
# Optional; defaults to 2026-10 (latest stable — see backend/docs/shopify-setup.md).
SHOPIFY_API_VERSION=2026-10
# Optional request timeout in seconds; defaults to 15.
SHOPIFY_HTTP_TIMEOUT_SECONDS=15

# --- Telegram ---
TELEGRAM_BOT_TOKEN=placeholder_from_botfather
TELEGRAM_WEBHOOK_SECRET=generate_a_random_string_for_hmac_check

# --- Database (do not provision until approved) ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Caching / rate limiting ---
REDIS_URL=redis://localhost:6379/0
